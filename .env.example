# Express Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173
SESSION_SECRET=your-session-secret-here

# Database Connection (PostgreSQL)
# DATABASE_URL: Transaction-pooled connection string from Supabase (port 6543)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/helpdesk?schema=public"
# DIRECT_URL: Direct non-pooled connection string from Supabase (port 5432) for running migrations
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/helpdesk?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/helpdesk_test?schema=public"

# Frontend Configuration (Vite)
# VITE_API_URL: Public URL of the deployed backend on Render (e.g. https://your-backend.onrender.com)
VITE_API_URL="http://localhost:5000"

# AI Service (Anthropic Claude)
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
AUTO_REPLY_CONFIDENCE_THRESHOLD=0.85

# Outbound Email (SendGrid / Mailgun)
SENDGRID_API_KEY="your-sendgrid-api-key-here"
EMAIL_FROM="support@helpdesk.edu"

# Better Auth Configuration
BETTER_AUTH_SECRET="your-better-auth-secret-here"
BETTER_AUTH_URL="http://localhost:5000"

# Default Admin Credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="password123"

# Trusted Origins for CORS / Auth
TRUSTED_ORIGINS="http://localhost:5173"

# Google Gemini Configuration
GEMINI_API_KEY="your-gemini-api-key-here"
